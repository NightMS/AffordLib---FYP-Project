<!DOCTYPE html>
<html lang="en">
<head>
  <title>Journal Articles - AffordaLib</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/register.css" />
</head>
<body>
  <%- include('partials/navbar') %>
  <% if (search || selectedTag || selectedDate) { %>
    <p class="text-muted">Showing filtered results</p>
    <% } %>

  <div class="container mt-5">
    <h2 class="text-center mb-4">Browse Journal Articles</h2>

    <form method="GET" action="/journals" class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" name="search" class="form-control" placeholder="Search by title or author" value="<%= search || '' %>">
        </div>

        <div class="col-md-3">
            <select name="tag" class="form-select">
            <option value="">-- Filter by Tag --</option>
            <% tags.forEach(tag => { %>
                <option value="<%= tag.id %>" <%= selectedTag == tag.id ? 'selected' : '' %>><%= tag.name %></option>
            <% }) %>
            </select>
        </div>

        <div class="col-md-3">
            <input type="date" name="date" class="form-control" value="<%= selectedDate || '' %>">
        </div>

        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>

        <div class="col-12 d-grid">
            <a href="/journals" class="btn btn-outline-secondary">Reset Filters</a>
        </div>
    </form>

    <div class="table-responsive shadow-sm rounded">
      <table class="table table-bordered table-hover align-middle text-center">
        <thead class="table-light">
          <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Tags</th>
            <th>Created Date</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (articles && articles.length > 0) { %>
            <% articles.forEach(article => { %>
              <tr>
                <td><%= article.title %></td>
                <td><%= article.author %></td>
                <td><%= article.tags %></td>
                <td><%= new Date(article.created_at).toLocaleDateString() %></td>
                <td>
                  <a href="/viewarticle/<%= article.id %>" class="btn btn-sm btn-info">Preview</a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6">No journal articles found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
