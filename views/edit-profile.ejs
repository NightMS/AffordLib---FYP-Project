<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Profile - <%= user.username %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles/register.css"> <!-- Make sure path is correct -->
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="form-wrapper">
    <form action="/profile/update-username" method="POST" class="mb-4 shadow-sm p-4 bg-white rounded" style="width: 100%; max-width: 400px;">
      <h3 class="text-center mb-3">Update Username</h3>
      <div class="form-floating mb-3">
        <input type="text" name="newUsername" class="form-control" id="newUsername" placeholder="New Username" value="<%= user.username %>" required>
        <label for="newUsername">New Username</label>
      </div>
      <button type="submit" class="btn btn-primary w-100">Update Username</button>
    </form>

    <form action="/profile/update-password" method="POST" class="shadow-sm p-4 bg-white rounded" style="width: 100%; max-width: 400px;">
      <h3 class="text-center mb-3">Change Password</h3>
      <div class="form-floating mb-3">
        <input type="password" name="currentPassword" class="form-control" id="currentPassword" placeholder="Current Password" required>
        <label for="currentPassword">Current Password</label>
      </div>

      <div class="form-floating mb-3">
        <input type="password" name="newPassword" class="form-control" id="newPassword" placeholder="New Password" required>
        <label for="newPassword">New Password</label>
      </div>

      <button type="submit" class="btn btn-warning w-100">Change Password</button>
    </form>
  </div>
</body>
</html>
