<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Home - AffordaLib</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/public/css/register.css"> <!-- Optional: reuse existing style -->
  <style>
    .homepage {
      min-height: 80vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 2rem;
      background-color: #f0f4f8;
    }
    .homepage h1 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }
    .homepage p {
      font-size: 1.2rem;
      color: #555;
    }
    .features {
      margin-top: 2rem;
      display: flex;
      gap: 2rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .feature-box {
      background: white;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
      padding: 1.5rem;
      max-width: 300px;
    }
  </style>
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="homepage">
    <h1>Welcome to AffordaLib</h1>
    <p>Discover affordable access to academic articles and journals — anywhere, anytime.</p>

    <div class="features">
      <div class="feature-box">
        <h5>📚 Vast Library</h5>
        <p>Access a wide range of academic journals and articles from various disciplines.</p>
      </div>
      <div class="feature-box">
        <h5>🔍 Smart Search</h5>
        <p>Use the search bar above to quickly find what you need using titles or keywords.</p>
      </div>
      <div class="feature-box">
        <h5>💡 Free & Paid Options</h5>
        <p>Explore both free and premium articles with flexible, low-cost subscriptions.</p>
      </div>
      <div class="feature-box">
        <h5>🔐 Secure User System</h5>
        <p>Register and log in securely to manage your saved content and profile.</p>
      </div>
    </div>
  </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
