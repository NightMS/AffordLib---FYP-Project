<!DOCTYPE html>
<html lang="en">
<head>
  <title>Manage Admins</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/register.css">
</head>
<body>
   <%- include('../partials/navbar') %>

  <div class="container mt-5">
    <h2 class="text-center mb-4">Manage Admin Accounts</h2>
    <div class="d-flex justify-content-between mb-3">
      <a href="/admin/addadmin" class="btn btn-primary">Add New Admin</a>
      <a href="/admindashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
     <form class="d-flex" action="/admin/manageadmins" method="GET">
        <input type="text" name="search" class="form-control me-2" placeholder="Search by username" value="<%= typeof search !== 'undefined' ? search : '' %>" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a href="/admin/manageadmins" class="btn btn-outline-primary">Reset</a>
      </form>

    <div class="table-responsive shadow-sm rounded">
      <table class="table table-bordered table-hover text-center">
        <thead class="table-light">
          <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% admins.forEach(admin => { %>
            <tr>
              <td><%= admin.username %></td>
              <td><%= admin.email %></td>
              <td>
                <a href="/admin/editadmin/<%= admin.id %>" class="btn btn-sm btn-warning">Edit</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
