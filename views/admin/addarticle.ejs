<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Article - AffordaLib Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/register.css" />
</head>
<style>
    .form-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh; /* Full height viewport */
      padding: 2rem;
      background-color: #f5f5f5;
    }

    form {
      max-width: 400px;
      width: 100%;
      background: white;
      padding: 2rem;
      border-radius: 8px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

  </style>
<body>
  <%- include('../partials/navbar') %>

  <div class="form-wrapper">
    <form action="/admin/addarticle" method="POST" enctype="multipart/form-data" class="p-4 shadow-sm bg-white rounded" style="max-width: 600px; width: 100%;">
      <h2 class="text-center mb-4">Add New Journal Article</h2>

      <div class="form-floating mb-3">
        <input type="text" name="title" id="title" class="form-control" placeholder="Title" required>
        <label for="title">Article Title</label>
      </div>

      <div class="form-floating mb-3">
        <input type="text" name="author" id="author" class="form-control" placeholder="Author Name" required>
        <label for="author">Author Name</label>
      </div>

      <div class="mb-3">
        <label for="tags" class="form-label">Tags</label>
        <select name="tags[]" id="tags" class="form-select" multiple required>
          <% tags.forEach(tag => { %>
            <option value="<%= tag.id %>"><%= tag.name %></option>
          <% }) %>
        </select>
        <div class="form-text">Hold Ctrl (Windows) or Cmd (Mac) to select multiple tags.</div>
      </div>

      <div class="mb-3">
        <label for="abstract" class="form-label">Abstract</label>
        <textarea name="abstract" id="abstract" class="form-control" rows="6" required placeholder="Enter article abstract here..."></textarea>
      </div>

      <div class="mb-3">
        <label for="visibility" class="form-label">Visibility</label>
        <select name="visibility" id="visibility" class="form-select" required>
          <option value="public">Public</option>
          <option value="private">Private (Monthly Pass Required)</option>
        </select>
      </div>

      <div class="mb-3">
        <label for="article_publish_time" class="form-label">Article Publish Time</label>
        <input type="date" name="article_publish_time" id="article_publish_time" class="form-control" required>
      </div>

      <div class="mb-4">
        <label for="pdf" class="form-label">Upload Article (PDF only)</label>
        <input type="file" name="pdf" id="pdf" class="form-control" accept="application/pdf" required>
      </div>

      <button type="submit" class="btn btn-primary w-100">Add Article</button>

      <div class="text-center mt-3">
        <a href="/admin/managejournalarticles" class="btn btn-link">← Back to Manage Articles</a>
      </div>
    </form>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
