<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Journal Articles - AffordaLib Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/register.css" />
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container mt-5">
    <h2 class="text-center mb-4">Manage Journal Articles</h2>
    <div class="d-flex justify-content-between flex-wrap mb-3">
      <div class="d-flex gap-2">
        <a href="/admin/addarticle" class="btn btn-primary">Add New Article</a>
        <a href="/admin/managetags" class="btn btn-secondary">Manage Tags</a>
      </div>
      <div>
        <a href="/admindashboard" class="btn btn-secondary">Back to Dashboard</a>
      </div>
    </div>

      <!-- Move the search form to its own row -->
      <div class="mb-3">
        <form class="d-flex gap-2" method="GET" action="/admin/managejournalarticles">
          <input type="text" name="search" class="form-control" placeholder="Search by title or author" value="<%= typeof search !== 'undefined' ? search : '' %>" />
          <button type="submit" class="btn btn-outline-primary">Search</button>
          <a href="/admin/managejournalarticles" class="btn btn-outline-primary">Reset</a>
        </form>
      </div>
    

    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle">
        <thead class="table-light text-center">
          <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Tags</th>
            <th>Visibility</th>
            <th>Publish Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody class="text-center">
          <% if (articles && articles.length > 0) { %>
            <% articles.forEach(article => { %>
              <tr>
                <td><%= article.title %></td>
                <td><%= article.author %></td>
                <td><%= article.tags %></td>
                <td class="<%= article.visibility === 'private' ? 'text-danger' : 'text-success' %> fw-semibold">
                  <%= article.visibility.charAt(0).toUpperCase() + article.visibility.slice(1) %>
                </td>
                <td>
                  <%= new Date(article.article_publish_time).toLocaleDateString('en-GB', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                  }) %>
                </td>
                <td>
                  <a href="/admin/editarticle/<%= article.id %>" class="btn btn-sm btn-warning">Edit</a>
                  <a href="/admin/deletearticle/<%= article.id %>" class="btn btn-sm btn-danger">Delete</a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center">No journal articles found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
