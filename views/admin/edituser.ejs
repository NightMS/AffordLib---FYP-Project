<!DOCTYPE html>
<html>
<head>
  <title>Edit User</title>
  <link href="/css/register.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<style>
    .form-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh; /* Full height viewport */
      padding: 2rem;
      background-color: #f5f5f5;
    }

    form {
      max-width: 400px;
      width: 100%;
      background: white;
      padding: 2rem;
      border-radius: 8px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

  </style>
<body>
  <%- include('../partials/navbar') %>

  <div class="form-wrapper">
    <form action="/admin/edituser/<%= user.id %>" method="POST" class="shadow-sm p-4 bg-white rounded" style="max-width: 400px; width: 100%;">
      <h3 class="text-center mb-3">Edit User</h3>

      <div class="form-floating mb-3">
        <input type="text" name="username" class="form-control" id="username" value="<%= user.username %>" required />
        <label for="username">Username</label>
      </div>

      <div class="form-floating mb-3">
        <input type="email" name="email" class="form-control" id="email" value="<%= user.email %>" required />
        <label for="email">Email</label>
      </div>

      <div class="form-floating mb-3">
        <select class="form-select" name="subscription" id="subscription" required>
          <option value="subscribe" <%= user.subscription === 'subscribe' ? 'selected' : '' %>>Subscribe</option>
          <option value="not subscribe" <%= user.subscription === 'not subscribe' ? 'selected' : '' %>>Not Subscribe</option>
        </select>
        <label for="subscription">Subscription Status</label>
      </div>

      <button type="submit" class="btn btn-primary w-100">Update User</button>
    </form>
  </div>
</body>
</html>
