<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Manage Tags</title>
  <link rel="stylesheet" href="/css/register.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container mt-5">
    <h2 class="text-center mb-4">Manage Tags</h2>

    <div class="d-flex justify-content-between mb-3">
      <a href="/admin/addtags" class="btn btn-primary">Add New Tag</a>
      <a href="/admindashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <form class="d-flex" method="GET" action="/admin/managetags">
        <input type="text" name="search" class="form-control me-2" placeholder="Search tags..." value="<%= typeof search !== 'undefined' ? search : '' %>" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a href="/admin/managetags" class="btn btn-outline-primary">Reset</a>
    </form>

    <table class="table table-bordered shadow-sm">
      <thead class="table-light text-center">
        <tr>
          <th>Tag Name</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody class="text-center">
        <% tags.forEach(tag => { %>
          <tr>
            <td><%= tag.name %></td>
            <td>
              <a href="/admin/edittag/<%= tag.id %>" class="btn btn-warning btn-sm">Edit</a>
              <a href="/admin/deletetag/<%= tag.id %>" class="btn btn-danger btn-sm">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
