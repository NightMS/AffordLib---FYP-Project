<!DOCTYPE html>
<html lang="en">
<head>
  <title>Add Tag - AffordaLib Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/register.css"> <!-- reuse your register.css -->
</head>
 <style>
    .form-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh; /* Full height viewport */
      padding: 2rem;
      background-color: #f5f5f5;
    }

    form {
      max-width: 400px;
      width: 100%;
      background: white;
      padding: 2rem;
      border-radius: 8px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

  </style>
<body>
<%- include('../partials/navbar') %>

<div class="form-wrapper">
  <form action="/admin/addtags" method="POST" class="profile-card">
    <h2 class="text-center mb-4">Add New Tag</h2>

    <div class="form-floating mb-3">
      <input type="text" id="name" name="name" class="form-control" placeholder="Tag Name" required>
      <label for="name">Tag Name</label>
    </div>

    <div class="text-center mt-3">
      <button type="submit" class="btn btn-primary w-100">Add Tag</button>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </form>
</div>
</body>
</html>