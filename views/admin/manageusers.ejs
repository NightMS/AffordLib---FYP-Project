<!DOCTYPE html>
<html lang="en">
<head>
  <title>Manage Users - AffordaLib Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/register.css"> <!-- reuse your CSS -->
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container mt-5">
    <h2 class="text-center mb-4">Manage Users</h2>

    <div class="d-flex justify-content-between mb-3">
      <a href="/admin/adduser" class="btn btn-success">Add New User</a>
      <a href="/admindashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <form class="d-flex" method="GET" action="/admin/manageusers">
      <input type="text" name="search" class="form-control me-2" placeholder="Search username or email..." value="<%= typeof search !== 'undefined' ? search : '' %>" />
      <button type="submit" class="btn btn-outline-primary">Search</button>
      <a href="/admin/manageusers" class="btn btn-outline-primary">Reset</a>
    </form>

    <div class="table-responsive shadow-sm rounded">
      <table class="table table-bordered table-hover text-center align-middle">
        <thead class="table-primary text-center">
          <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Subscription</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td><%= user.username %></td>
            <td><%= user.email %></td>
            <td>
              <% if (user.subscription === 'subscribe') { %>
                <span class="badge bg-success">Subscribed</span>
              <% } else { %>
                <span class="badge bg-secondary">Not Subscribed</span>
              <% } %>
            </td>
            <td>
              <a href="/admin/edituser/<%= user.id %>" class="btn btn-sm btn-warning">Edit</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
      </table>
    </div>
  </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
